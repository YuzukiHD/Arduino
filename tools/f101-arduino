#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Build and upload Arduino sketches for the Allwinner F101 (Zephyr based core).

  f101-arduino build  <sketch-dir|sketch.ino> [-o BUILD_DIR] [--variant evb] [-L LIBDIR]...
  f101-arduino upload <BUILD_DIR|zephyr.bin>  [--xfel PATH]
  f101-arduino run    <sketch> ...               build, then upload

The sketch is turned into C++ the way the Arduino IDE does it: the .ino files
are concatenated (main file first), Arduino.h is included and prototypes of the
functions are generated. The libraries used by the #includes are linked.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent          # Arduino/
# west workspace: this checkout itself when tools/setup was run here (zephyr is a
# submodule), else the directory above (Arduino/ lives inside a west workspace)
WS = ROOT if (ROOT / ".west").is_dir() else ROOT.parent
LOAD_ADDR = "0x40010000"


def env():
    e = dict(os.environ)
    e["ZEPHYR_BASE"] = str(WS / "zephyr")
    e["ZEPHYR_TOOLCHAIN_VARIANT"] = "cross-compile"
    if not e.get("CROSS_COMPILE"):
        tc = sorted((WS / "toolchains").glob("Xuantie-900-gcc-elf-newlib-*/bin/riscv64-unknown-elf-gcc"))
        if tc:
            e["CROSS_COMPILE"] = str(tc[-1])[:-3]
    venv = WS / ".venv"
    paths = [str(WS / "tools-local/usr/bin")]
    if (venv / "bin").is_dir():
        paths.insert(0, str(venv / "bin"))
        e["VIRTUAL_ENV"] = str(venv)
    e["PATH"] = os.pathsep.join(paths + [e.get("PATH", "")])
    return e


# ---------------------------------------------------------------- sketch -> C++

FUNC_RE = re.compile(
    r"^[ \t]*((?:static\s+|inline\s+|const\s+|unsigned\s+|signed\s+|volatile\s+|struct\s+)*"
    r"[A-Za-z_][\w:<>]*[\s\*&]+[A-Za-z_]\w*\s*\([^;{}()]*(?:\([^)]*\)[^;{}()]*)*\))\s*\{",
    re.M)
KEYWORDS = {"if", "for", "while", "switch", "else", "return", "do", "catch", "sizeof"}


def strip_comments(src):
    out = re.sub(r"/\*.*?\*/", lambda m: re.sub(r"[^\n]", " ", m.group()), src, flags=re.S)
    return re.sub(r"//[^\n]*", "", out)


def prototypes(src):
    clean = strip_comments(src)
    depth = 0
    top = []
    for line in clean.splitlines(keepends=True):
        top.append(line if depth == 0 else "\n")
        depth += line.count("{") - line.count("}")
    text = "".join(top)
    protos = []
    for m in FUNC_RE.finditer(text):
        decl = " ".join(m.group(1).split())
        name = re.search(r"([A-Za-z_]\w*)\s*\(", decl).group(1)
        first = decl.split()[0]
        if name in KEYWORDS or first in KEYWORDS or first in ("class", "struct", "enum", "namespace"):
            continue
        protos.append(decl + ";")
    return protos


def sketch_to_cpp(sketch_dir, main_ino, out_dir):
    inos = [main_ino] + sorted(p for p in sketch_dir.glob("*.ino") if p != main_ino)
    body = "".join(p.read_text(errors="replace") + "\n" for p in inos)
    # keep #include lines first, as the Arduino IDE does, then the prototypes
    first_code = re.search(r"^(?!\s*(//|/\*|\*|#|$))", body, re.M)
    pos = first_code.start() if first_code else len(body)
    head, rest = body[:pos], body[pos:]
    protos = "\n".join(prototypes(body))
    out = out_dir / (main_ino.stem + ".ino.cpp")
    out.write_text('#include <Arduino.h>\n' + head + "\n" + protos + '\n#line 1 "%s"\n' % main_ino + rest)
    extra = [str(p) for p in sorted(sketch_dir.glob("*.cpp")) + sorted(sketch_dir.glob("*.c"))]
    return [str(out)] + extra


def find_libraries(sketch_dir, lib_paths):
    """Library names for the #include lines of the sketch (transitively through libraries)."""
    index = {}
    for base in lib_paths + [ROOT / "libraries"]:
        if not base.is_dir():
            continue
        for lib in sorted(p for p in base.iterdir() if p.is_dir()):
            src = lib / "src" if (lib / "src").is_dir() else lib
            for h in list(src.glob("*.h")) + list(src.glob("*/*.h")):
                index.setdefault(h.name, lib)
    found, queue = [], []
    sources = [p for ext in ("*.ino", "*.cpp", "*.c", "*.h") for p in sketch_dir.glob(ext)]
    inc = re.compile(r'^\s*#\s*include\s*[<"]([^>"]+)[>"]', re.M)
    for s in sources:
        queue += inc.findall(s.read_text(errors="replace"))
    seen = set()
    while queue:
        name = os.path.basename(queue.pop())
        if name in seen or name not in index:
            continue
        seen.add(name)
        lib = index[name]
        if lib.name not in found:
            found.append(lib.name)
            src = lib / "src" if (lib / "src").is_dir() else lib
            for f in list(src.glob("*.h")) + list(src.glob("*.cpp")) + list(src.glob("*/*.cpp")):
                queue += inc.findall(f.read_text(errors="replace"))
            props = lib / "library.properties"
            if props.exists():
                m = re.search(r"^depends=(.*)$", props.read_text(), re.M)
                if m:
                    for dep in (d.strip() for d in m.group(1).split(",") if d.strip()):
                        for h in index:
                            if index[h].name == dep:
                                queue.append(h)
                                break
    return found


# ---------------------------------------------------------------- commands

def resolve_sketch(arg):
    p = Path(arg).resolve()
    if p.is_file() and p.suffix == ".ino":
        return p.parent, p
    if p.is_dir():
        main = p / (p.name + ".ino")
        if not main.exists():
            inos = sorted(p.glob("*.ino"))
            if not inos:
                sys.exit(f"no .ino in {p}")
            main = inos[0]
        return p, main
    sys.exit(f"sketch not found: {arg}")


def cmd_build(a):
    sketch_dir, main = resolve_sketch(a.sketch)
    build = Path(a.output).resolve() if a.output else WS / "build" / "arduino" / sketch_dir.name
    if a.pristine and build.exists():
        shutil.rmtree(build)
    gen = build / "sketch"
    gen.mkdir(parents=True, exist_ok=True)
    lib_paths = [Path(p).resolve() for p in (a.library or [])]
    lib_paths.append(sketch_dir / "libraries")
    sources = sketch_to_cpp(sketch_dir, main, gen)
    libs = find_libraries(sketch_dir, lib_paths)
    print("sketch libraries:", ", ".join(libs) or "-")
    cmd = ["west", "build", "-b", a.board, "-d", str(build), str(ROOT)]
    cmd += ["--",
            f"-DARDUINO_VARIANT={a.variant}",
            f"-DARDUINO_SKETCH_DIR={sketch_dir}",
            f"-DARDUINO_SKETCH={';'.join(sources)}",
            f"-DARDUINO_LIBRARIES={';'.join(libs)}",
            f"-DARDUINO_LIBRARY_PATHS={';'.join(str(p) for p in lib_paths)}"]
    if a.overlay:
        cmd.append("-DEXTRA_DTC_OVERLAY_FILE=" + ";".join(str(Path(o).resolve()) for o in a.overlay))
    for c in a.conf or []:
        cmd.append("-DEXTRA_CONF_FILE=" + str(Path(c).resolve()))
    r = subprocess.run(cmd, env=env(), cwd=WS)
    if r.returncode:
        sys.exit(r.returncode)
    out = build / "zephyr" / "zephyr.bin"
    print(f"\n{out}  ({out.stat().st_size} bytes)")
    if getattr(a, "copy_to", None):
        shutil.copyfile(out, a.copy_to)
    return out


def cmd_upload(a):
    p = Path(a.image).resolve()
    if p.is_dir():
        p = p / "zephyr" / "zephyr.bin"
    if not p.exists():
        sys.exit(f"image not found: {p}")
    xfel = a.xfel or shutil.which("xfel")
    if not xfel:
        sys.exit("xfel not found (use --xfel PATH). The board has to be in FEL mode: power cycle it first.")
    for step in ([xfel, "version"], [xfel, "ddr", "f101-s3"], [xfel, "write", LOAD_ADDR, str(p)],
                 [xfel, "exec", LOAD_ADDR]):
        print("+", " ".join(step))
        if subprocess.run(step).returncode:
            sys.exit("xfel failed (a download needs a fresh power cycle into FEL)")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("build", "run"):
        b = sub.add_parser(name)
        b.add_argument("sketch")
        b.add_argument("-o", "--output")
        b.add_argument("--variant", default="evb")
        b.add_argument("--board", default="yuzukineko/sun252i_f101/evb")
        b.add_argument("-L", "--library", action="append", help="extra library directory")
        b.add_argument("--overlay", action="append", help="extra devicetree overlay (e.g. a pin overlay of a library)")
        b.add_argument("--conf", action="append", help="extra Kconfig fragment")
        b.add_argument("-p", "--pristine", action="store_true")
        b.add_argument("--copy-to", help="also copy zephyr.bin here (used by the IDE package)")
        if name == "run":
            b.add_argument("--xfel")
    u = sub.add_parser("upload")
    u.add_argument("image")
    u.add_argument("--xfel")
    n = sub.add_parser("noop", help="create empty output files (Arduino IDE package recipes)")
    n.add_argument("files", nargs="+")
    a = ap.parse_args()
    if a.cmd == "noop":
        for f in a.files:
            Path(f).parent.mkdir(parents=True, exist_ok=True)
            Path(f).touch()
    elif a.cmd == "build":
        cmd_build(a)
    elif a.cmd == "upload":
        cmd_upload(a)
    else:
        a.image = cmd_build(a)
        cmd_upload(a)


if __name__ == "__main__":
    main()
